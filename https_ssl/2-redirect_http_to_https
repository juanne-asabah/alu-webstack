global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    maxconn 2048
    tune.ssl.default-dh-param 2048

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    option  forwardfor
    timeout connect 5000
    timeout client  50000
    timeout server  50000

frontend www-http
    bind *:80
    http-request redirect scheme https code 301 unless { ssl_fc }

frontend www-https
    bind *:443 ssl crt /etc/haproxy/certs/www.juanne-lab.abrdns.com.pem
    http-request set-header X-Forwarded-Proto https
    default_backend web-backend

backend web-backend
    balance roundrobin
    server 7244-web-01 35.177.108.124:80 check
    server 7244-web-02 18.171.134.109:80 check
