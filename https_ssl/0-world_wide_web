#!/usr/bin/env bash
# Display DNS record information for subdomains

display_dns() {
	record=$(dig "$2.$1" | grep -A1 'ANSWER SECTION:' | tail -n 1)
	rec_type=$(echo "$record" | awk '{print $4}')
	dest=$(echo "$record" | awk '{print $5}')
	echo "The subdomain $2 is a $rec_type record and points to $dest"
}

if [ $# -eq 1 ]; then
	for sub in www lb-01 web-01 web-02; do
		display_dns "$1" "$sub"
	done
elif [ $# -eq 2 ]; then
	display_dns "$1" "$2"
fi
